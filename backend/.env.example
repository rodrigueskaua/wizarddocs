APP_ENV=development

# Provedores de LLM (opcionais). Sem nenhuma chave, só o modo "local" (busca sem LLM) funciona.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LLM_PROVIDER=
LLM_TIMEOUT=60

# Busca semântica. Trocar provider/modelo cria uma coleção nova; os PDFs precisam ser reenviados.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Usados só quando EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_DISTANCE=0.20

CHROMADB_DIR=./chroma_db
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173